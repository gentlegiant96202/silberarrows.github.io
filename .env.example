# Site

# Supabase – LEADS project
# Used by /api/lead to insert into the `leads` table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase – BLOG project (shared with portal.silberarrows.com)
# Read-only on this site (anon key only). Portal app holds the service
# role key. RLS must allow anon `select` on published posts.
NEXT_PUBLIC_SUPABASE_BLOG_URL=
NEXT_PUBLIC_SUPABASE_BLOG_ANON_KEY=

# Blog ISR webhook
# Portal POSTs to /api/revalidate with header: x-revalidate-secret: <secret>
# Generate a strong random value (e.g. `openssl rand -hex 32`) and set on
# both portal and marketing site environments.
BLOG_REVALIDATE_SECRET=

# SEO verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow (optional but recommended)
# Generate with `openssl rand -hex 32`. Server-only, no NEXT_PUBLIC_ prefix.
# The marketing site serves this value at /indexnow/<key> as plain text so
# Bing/Yandex/Seznam/Naver can verify domain ownership when /api/revalidate
# pushes new URLs to them after a blog publish.
INDEXNOW_KEY=

# Meta Pixel & Conversions API (optional). When both are set the server sends:
#   Lead    – quote form submit        (/api/lead)
#   Contact – Call / WhatsApp click    (/api/contact-click)
# Each is deduplicated against the browser Pixel event via a shared event_id.
META_PIXEL_ID=941983558202599
META_CAPI_ACCESS_TOKEN=

# Test events: when set, CAPI events go to Events Manager → Test events (e.g. TEST50369).
META_TEST_EVENT_CODE=

# Google Ads – client-side conversion tracking (gtag)
# Create 3 "Website" conversion actions in Google Ads (Lead Form Submit,
# WhatsApp Click, Phone Click). Each gives a tag like:
#   send_to: 'AW-123456789/AbC-D_efGh12'
# Put the AW- id below and each conversion's label (the part after the slash).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GADS_PHONE_LABEL=

# Google Ads API (LEGACY server-side offline upload — DEPRECATED)
# Google blocks Google Ads API offline conversion uploads on 2026-06-15
# (migrating to the Data Manager API). The client-side gtag tracking above
# replaces this for the web form. The upload in /api/lead is OFF unless you
# explicitly set GOOGLE_ADS_OFFLINE_UPLOAD_ENABLED=true, so you can keep the
# creds below for future Data Manager API work without firing the broken path.
GOOGLE_ADS_OFFLINE_UPLOAD_ENABLED=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
