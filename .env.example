# Site

# Supabase (shared with portal.silberarrows.com)
# - Public/anon key is safe to expose to browser; the marketing site only reads.
# - Service role key is NEVER used here; it lives only in the portal app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blog ISR webhook
# Portal POSTs to /api/revalidate with header: x-revalidate-secret: <secret>
# Generate a strong random value (e.g. `openssl rand -hex 32`) and set on
# both portal and marketing site environments.
BLOG_REVALIDATE_SECRET=

# SEO verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Meta Pixel & Conversions API (optional – server sends Lead to CAPI when set)
META_PIXEL_ID=941983558202599
META_CAPI_ACCESS_TOKEN=

# Test events: when set, CAPI events go to Events Manager → Test events (e.g. TEST50369).
META_TEST_EVENT_CODE=

# Google Ads API (optional – lead uploads click conversion when set)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
