# Supabase (optional – lead row in `leads` table; webhook still runs without this)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Pixel & Conversions API (optional – server sends Lead to CAPI when set)
META_PIXEL_ID=941983558202599
META_CAPI_ACCESS_TOKEN=

# Test events: when set, CAPI events go to Events Manager → Test events (e.g. TEST50369).
META_TEST_EVENT_CODE=

# Google Ads API (optional – lead uploads click conversion when set)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
